# Core runtime
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=./var/trading_agent.db
UNIVERSE_CSV=./data/universe.csv
US_UNIVERSE_CSV=./data/us_universe.csv
UNIVERSE_SOURCE=csv
MARKET_REGION=IN
NSE_EQUITY_LIST_URL=https://archives.nseindia.com/content/equities/EQUITY_L.csv
NSE_UNIVERSE_REFRESH_ON_START=false
NSE_UNIVERSE_SERIES=EQ
UNIVERSE_SYMBOLS_PER_CYCLE=0
DYNAMIC_OPPORTUNITY_SCAN_ENABLED=true
DYNAMIC_SCAN_RAW_LIMIT=0
DYNAMIC_SCAN_CANDIDATE_LIMIT=60
DYNAMIC_SCAN_MIN_SCORE=0.58
DYNAMIC_SCAN_REQUIRE_ACTIVE_SETUP=true
DYNAMIC_SCAN_MIN_PRICE=10
DYNAMIC_SCAN_MIN_TURNOVER_INR=50000000
DYNAMIC_SCAN_BREAKOUT_DISTANCE_PCT=3
DYNAMIC_SCAN_SENTIMENT_ENABLED=true
DYNAMIC_SCAN_NEWS_PROBE_LIMIT=16
DYNAMIC_SCAN_SENTIMENT_WEIGHT=0.12
RS_BENCHMARK_SYMBOLS_IN=NIFTY500,NIFTY50
RS_BENCHMARK_SYMBOLS_US=SPY,QQQ
RS_BENCHMARK_INSTRUMENT_KEYS_IN=NIFTY500:NSE_INDEX|Nifty 500,NIFTY50:NSE_INDEX|Nifty 50
AUTO_START_AGENT=true
AGENT_INTERVAL_SECONDS=180
CYCLE_TIMEOUT_SECONDS=120
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
AUTH_SESSION_SECRET=
ADMIN_SESSION_HOURS=12

# Dry-money portfolio
INITIAL_CASH_INR=10000
MAX_POSITIONS=5
MAX_POSITION_PCT=0.15
MAX_ORDER_VALUE_PCT=0.10
MAX_TRADES_PER_CYCLE=2
STOP_LOSS_PCT=0.035
TAKE_PROFIT_PCT=0.08
DAILY_LOSS_LIMIT_PCT=0.025

# Market data provider:
# - simulated: works immediately, not live
# - yahoo: best-effort delayed public quotes, not exchange-authorized live data
# - kite: Zerodha Kite Connect live quotes with your API key + daily access token
# - upstox: Upstox REST market quotes/candles with your access token
# - nubra: Nubra REST current price and historical candles with session token + device id
# - alpaca_yahoo: Alpaca US quotes/minute bars plus Yahoo historical fallback
MARKET_DATA_PROVIDER=simulated
KITE_API_KEY=
KITE_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/upstox/callback
UPSTOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_ORDER_BASE_URL=https://api-hft.upstox.com/v2
UPSTOX_CANDLE_INTERVAL=30minute
UPSTOX_CANDLE_LOOKBACK_DAYS=3
YAHOO_CANDLE_INTERVAL=15m
YAHOO_CANDLE_RANGE=5d
ENABLE_YAHOO_CANDLE_FALLBACK=true
US_MARKET_DATA_PROVIDER=yahoo
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Use iex for basic Alpaca data access, sip only when the account has SIP data permission.
ALPACA_DATA_FEED=iex
POLYGON_API_KEY=
NUBRA_API_BASE_URL=https://uatapi.nubra.io
NUBRA_PHONE=
NUBRA_MPIN=
NUBRA_SESSION_TOKEN=
NUBRA_DEVICE_ID=
NUBRA_PRICE_SCALE=100
NUBRA_CANDLE_INTERVAL=15m
NUBRA_CANDLE_LOOKBACK_DAYS=3
NUBRA_CANDLE_SYMBOLS_PER_CYCLE=30
NUBRA_OPTION_CHAIN_ENDPOINT=
NUBRA_MARKET_DEPTH_ENDPOINT=
NUBRA_DELIVERY_ENDPOINT=
NUBRA_OI_ENDPOINT=

# Sentiment. Keep rate limits conservative for free-tier hosting.
ENABLE_NEWS_SENTIMENT=true
ENABLE_LLM_SENTIMENT=false
NEWS_CACHE_SECONDS=1800
NEWS_LOOKBACK_DAYS=7
NEWS_SYMBOLS_PER_CYCLE=2

# Global intelligence. Used as a macro risk input in every stock decision.
ENABLE_GLOBAL_INTELLIGENCE=true
GLOBAL_CACHE_SECONDS=900
GLOBAL_NEWS_LOOKBACK_DAYS=2
GLOBAL_RISK_WEIGHT=0.10

# Free institutional feeds. These are public/best-effort/EOD where applicable.
ENABLE_FREE_INSTITUTIONAL_FEEDS=true
FREE_FEED_CACHE_SECONDS=1800
FREE_FEED_TIMEOUT_SECONDS=10
FREE_FEED_OPTION_CHAIN_SYMBOLS=NIFTY,BANKNIFTY
FREE_FEED_CORPORATE_LOOKBACK_DAYS=2
INSTITUTIONAL_RISK_WEIGHT=0.12
ENABLE_DELIVERY_DATA=true
DELIVERY_CACHE_SECONDS=86400
DELIVERY_FETCH_DAYS=20
ENABLE_MARKET_BREADTH=true
MARKET_BREADTH_CACHE_SECONDS=60
ENABLE_SECTOR_ROTATION=true
SECTOR_ROTATION_CACHE_SECONDS=300
ENABLE_MACRO_CALENDAR=true
MACRO_CALENDAR_CACHE_SECONDS=3600

# Execution:
# - paper: internal demo ledger only, uses live quotes if MARKET_DATA_PROVIDER=upstox
# - upstox_sandbox: internal ledger plus Upstox sandbox order API
# - upstox_live: internal ledger plus real Upstox order API, requires confirmation
EXECUTION_MODE=paper
LIVE_TRADING_ENABLED=false
LIVE_TRADING_CONFIRM=
UPSTOX_ORDER_PRODUCT=D
UPSTOX_ORDER_VALIDITY=DAY
UPSTOX_ORDER_TYPE=MARKET

# LLM brain. OpenTrade uses direct DeepSeek only.
# LLM_DECISION_MODE:
# - review: deterministic strategy proposes, LLM reviews candidates
# - primary: LLM makes the action decision from tool context
# - offline: deterministic local heuristic only
LLM_PROVIDER=deepseek
LLM_DECISION_MODE=primary
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.05
LLM_TOP_P=0.7
LLM_MAX_TOKENS=4096
LLM_MAX_SYMBOLS_PER_CYCLE=8
LLM_PRIMARY_MIN_CONFIDENCE=0.62
LLM_REASONING_EFFORT=high
LLM_THINKING_ENABLED=true
LLM_STREAMING_ENABLED=false
LLM_TIMEOUT_SECONDS=120
LLM_ROLLING_CONTEXT_ENABLED=true
LLM_ROLLING_CONTEXT_THRESHOLD_CHARS=16000
LLM_ROLLING_CONTEXT_CHUNK_CHARS=7000
LLM_ROLLING_CONTEXT_MAX_CHUNKS=0
