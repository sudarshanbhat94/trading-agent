[Unit]
Description=OpenTrade NSE corporate-announcements ingester (real-time catalyst feed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/opentrade
EnvironmentFile=/opt/opentrade/.env
ExecStart=/opt/opentrade/.venv/bin/python scripts/nse_announcements.py --loop --interval 300
Restart=always
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
