[Unit]
Description=Source-backed paper-only Nifty 500 cash contracts
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/opentrade
EnvironmentFile=/opt/opentrade/.env
ExecStart=/opt/opentrade/.venv/bin/python scripts/refresh_nse_cash_contracts.py --db /opt/opentrade/var/trading_agent.db --reference-db /opt/opentrade/var/sleeve_reference.db --archive /opt/opentrade/var/nse_contract_sources
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/opentrade/var
UMask=0077
