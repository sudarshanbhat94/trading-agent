[Unit]
Description=Import reviewed daily instrument rules and exchange sessions
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/opentrade
EnvironmentFile=/opt/opentrade/.env
ExecStart=/opt/opentrade/.venv/bin/python scripts/import_contract_evidence.py --bundle ${OPENSTOCKS_CONTRACT_BUNDLE} --db ${OPENSTOCKS_CATALOGUE_DB}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/opentrade/var
UMask=0077
