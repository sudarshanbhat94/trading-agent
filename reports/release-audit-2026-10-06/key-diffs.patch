+        policy=native_policy(uid,product)
+        if not policy:continue
+        try:
+            request_native(con,uid,entry_id,authorization_reference=policy['reference']+' / '+policy['source_commit'])
+            activated+=1
+        except ValueError:
+            with atomic(con):
+                row=_row(con,uid,entry_id)
