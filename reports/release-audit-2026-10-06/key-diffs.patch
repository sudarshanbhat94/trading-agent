+function accountMoney(value){return typeof value==='number'&&Number.isFinite(value)?new Intl.NumberFormat(PAPER_REPORT_CURRENCY==='INR'?'en-IN':'en-US',{style:'currency',currency:PAPER_REPORT_CURRENCY,maximumFractionDigits:2}).format(value):'—';}
+function accountNumber(value,unit){return typeof value==='number'&&Number.isFinite(value)?value.toFixed(unit==='R'?2:1)+(unit||''):'—';}
+function accountGroup(title,groups){var keys=Object.keys(groups||{});return '<section class=desk-panel><h2>'+esc(title)+'</h2>'+(keys.length?keys.map(function(key){var s=groups[key];return '<div class=account-report-row><b>'+esc(key.replace(/_/g,' '))+'</b><div><small>Closed trades</small>'+esc(s.trades)+'</div><div><small>Net P&L</small>'+accountMoney(s.net_pnl)+'</div><div><small>Win rate</small>'+accountNumber(s.win_rate,'%')+'</div><div><small>Average R · '+esc(s.r_observations)+' observed</small>'+accountNumber(s.average_r,'R')+'</div></div>';}).join(''):'<p class=desk-note>No closed trades in this period.</p>')+'</section>';}
+function personalReportHtml(report){PAPER_REPORT_CURRENCY=report.currency==='USD'?'USD':'INR';var b=report.book||{},period=PAPER_REPORT_PERIOD==='day'?'daily':'current_epoch',s=report[period]||{};
+ var h='<section class=desk-panel><div class=desk-head><div><div class=desk-eyebrow>YOUR PAPER · ACTUAL FILLS</div><h2>Account performance</h2></div><span class=desk-status>'+esc(report.currency)+'</span></div><p class=desk-note>Current epoch · '+esc(report.epoch)+'</p>';
