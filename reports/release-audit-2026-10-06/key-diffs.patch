+.account-protection-row{display:flex;gap:14px;justify-content:space-between;flex-wrap:wrap;padding:13px 0;border-top:1px solid var(--line)}
+@media(max-width:620px){.account-report-row{grid-template-columns:repeat(2,minmax(0,1fr))}.account-report-row>b{grid-column:1/-1}.desk-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
